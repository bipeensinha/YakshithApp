@{
    ViewBag.Title = "Developer | Azure Training 205";
}

<section class="dev-page">

    <div class="dev-hero">

        <div class="dev-hero-copy">
            <div class="dev-status">
                <span class="dev-status-dot"></span>
                Azure Developer • Cloud &amp; AI
            </div>

            <h1>
                Building
                <span>modern cloud</span>
                experiences.
            </h1>

            <p class="dev-lead">
                Welcome to my developer showcase. I build practical applications
                that connect modern development, Azure cloud services, GitHub,
                CI/CD and AI.
            </p>

            <div class="dev-actions">
                <a href="#project" class="dev-btn dev-btn-primary">Explore Project <span>→</span></a>
                <a href="#expertise" class="dev-btn">View Expertise</a>
            </div>

            <div class="dev-tech-row">
                <span>ASP.NET MVC</span>
                <span>Azure</span>
                <span>GitHub</span>
                <span>CI/CD</span>
                <span>AI</span>
            </div>
        </div>

        <div class="dev-profile-card">

            <div class="dev-photo-wrap">
                <img src="/Content/images/developer-photo.jpg"
                     alt="Bipeen Sinha - Developer"
                     class="dev-photo"
                     onerror="this.style.display='none'; document.getElementById('developerFallback').style.display='flex';" />

                <div id="developerFallback" class="dev-photo-fallback">
                    BS
                </div>

                <div class="dev-photo-glow"></div>
            </div>

            <div class="dev-profile-info">
                <p class="dev-profile-label">DEVELOPER</p>
                <h2>Bipeen Sinha</h2>
                <p class="dev-role">Cloud &amp; Application Developer</p>
                <p class="dev-description">
                    Building and demonstrating cloud-ready applications
                    with a focus on Azure, automation and intelligent solutions.
                </p>

                <div class="dev-socials">
                    <a href="#" class="dev-social" title="GitHub">GH</a>
                    <a href="#" class="dev-social" title="LinkedIn">in</a>
                    <a href="#project" class="dev-social" title="Featured project">↗</a>
                </div>
            </div>

        </div>

    </div>


    <div class="dev-section" id="expertise">

        <div class="dev-section-heading">
            <p class="dev-kicker">EXPERTISE</p>
            <h2>Technology with a purpose.</h2>
            <p>
                Practical development skills brought together in one modern cloud experience.
            </p>
        </div>

        <div class="dev-cards">

            <article class="dev-card">
                <div class="dev-card-icon">☁</div>
                <h3>Azure Cloud</h3>
                <p>
                    Building and deploying web applications using Azure App Service
                    and cloud-based development practices.
                </p>
            </article>

            <article class="dev-card">
                <div class="dev-card-icon">⚙</div>
                <h3>Git &amp; CI/CD</h3>
                <p>
                    Connecting source control and deployment workflows to move
                    applications from development to the cloud.
                </p>
            </article>

            <article class="dev-card">
                <div class="dev-card-icon">🤖</div>
                <h3>AI Applications</h3>
                <p>
                    Exploring practical AI solutions that can improve enterprise
                    support, automation and user experiences.
                </p>
            </article>

        </div>

    </div>


    <div class="dev-section" id="project">

        <div class="dev-project">

            <div class="dev-project-icon">🚀</div>

            <div class="dev-project-content">
                <p class="dev-kicker">FEATURED PROJECT</p>
                <h2>Enterprise AI Service Desk</h2>
                <p>
                    A modern enterprise support concept designed to demonstrate
                    intelligent IT assistance, agent workflows and cloud deployment.
                </p>

                <div class="dev-project-flow">
                    <span>Code</span>
                    <b>→</b>
                    <span>GitHub</span>
                    <b>→</b>
                    <span>Azure</span>
                    <b>→</b>
                    <span>Live App</span>
                </div>
            </div>

        </div>

    </div>


    <div class="dev-about">

        <div>
            <p class="dev-kicker">ABOUT THE DEVELOPER</p>
            <h2>Turning ideas into working applications.</h2>
        </div>

        <p>
            This page is designed as a professional developer landing page for
            the Azure Training 205 project. Replace the profile image and social
            links with the developer's actual details before publishing.
        </p>

    </div>

</section>
